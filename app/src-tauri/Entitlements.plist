<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Under the hardened runtime, macOS silently refuses microphone (sound card input) access
       without this, and never shows the permission prompt. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
